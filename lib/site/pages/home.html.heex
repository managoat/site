<%!-- The page has three surfaces, and every section is on one of them.

      `bg-0` is the page. `--color-band` is the tint that groups two adjacent
      sections into one beat. `--color-ink-*` is the dark surface, and it does
      not invert with the theme: an ink section is dark in light mode, and in
      dark mode the same tokens lift it clear of the near-black page. Two
      sections are ink, the manifest and the finale, and they bracket the
      argument between them.

      Every section opens with `eyebrow/1`. Ten sections used to open with the
      same centred heading and nothing else, so a reader had no way to tell
      which one they were in.

      VERTICAL RHYTHM, and it is the site's, not this page's. Measured as the
      distance from a section's edge — a band edge, a hairline rule, or the
      neighbouring section — to the first or last thing that paints:

        80px  `py-20`, the two ends of a page: the hero and the closer.
        64px  `py-16`, every body section, on both sides.
        32px  `py-8`, half a step, for the leading side of a section that
              butts against another on the same surface with no rule and no
              band edge between them. Nothing explains that boundary, so it
              gets one beat rather than two: the case study below is the only
              one on this page.

      A section whose content is a padded panel counts the panel's padding as
      part of its own, because the panel's border is the edge a reader sees.

      This page used to run the whole scale one step wide — `py-20` bodies and
      a `py-24` closer against `py-16` everywhere else on the site — which is
      how the same boundary came out at 152, 168 and 217 pixels depending on
      what was above it. --%>

<%!-- Hero. The goat talks to a sprite, which is the whole product in one
      picture: you (the goat) send a prompt, an agent on a sandbox (the sprite)
      answers and delivers, and the rest of the herd drifts around, one of them
      asleep, because a parked sandbox is a napping one. The motion lives in
      `fun.css`, and the baa is the script at the bottom of this page. --%>
<section class="max-w-5xl mx-auto px-6 py-12 text-center" data-role="hero">
  <p
    class="mb-4 inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-1)] px-3.5 py-1.5 text-xs text-[var(--color-text-secondary)]"
    data-role="hosted-brand"
  >
    <span class="size-1.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
    {Site.Brand.name()} runs on {Site.Brand.engine()}, an open-source server you can run yourself.
  </p>

  <div class="goat-scene mb-6" data-role="goat-scene">
    <.sprite class="sprite-drift" style="left: 4%; top: 78%;" />
    <.sprite class="sprite-drift" style="left: 46%; top: 6%;" />
    <.sprite class="sprite-drift" style="right: 3%; top: 4%;" />
    <span class="sprite-asleep sprite" style="left: 30%; bottom: 2%;" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0c.6 6.4 5.6 11.4 12 12-6.4.6-11.4 5.6-12 12-.6-6.4-5.6-11.4-12-12C6.4 11.4 11.4 6.4 12 0z" />
      </svg>
      <span class="sprite-zzz">zzz</span>
    </span>

    <div class="scene-row">
      <button type="button" class="scene-goat" data-role="goat" aria-label="Pet the goat">
        <img src={Site.Brand.asset("app-icon.png")} alt="" width="88" height="88" />
      </button>
      <p class="bubble bubble-goat say-1">add a --version flag and open a PR</p>
    </div>
    <div class="scene-row scene-row-right">
      <p class="bubble bubble-sprite say-2">on it ✨ checkout's already here</p>
      <.sprite class="sprite-main" />
    </div>
    <div class="scene-row scene-row-right pr-14">
      <p class="bubble bubble-sprite say-3">PR #42 is up. Tests pass. Going back to sleep 💤</p>
    </div>
  </div>

  <h1 class="text-[2.75rem] leading-[1.05] sm:text-6xl font-bold tracking-[-0.03em] text-[var(--color-text-primary)] mb-6">
    A goat that talks to sprites.
  </h1>
  <p class="text-lg sm:text-xl leading-relaxed text-[var(--color-text-secondary)] max-w-2xl mx-auto mb-10">
    {Site.Brand.name()} gives a coding agent (Claude Code, Codex or Gemini CLI) its own little cloud computer, a sprite, and then lets you chat with it.
    The sprite keeps your repo, your packages and its half-finished work, naps between prompts, and wakes up right where it left off.
  </p>
  <div class="flex flex-col sm:flex-row gap-3 justify-center mb-12">
    <a
      href="https://fountain-conversations.demo.managoat.com/"
      class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-[var(--color-brand)] text-white font-medium hover:bg-[var(--color-brand-hover)] transition-colors text-sm shadow-sm"
    >
      Talk to a sprite
    </a>
    <a
      href="/docs/tour"
      class="inline-flex items-center justify-center px-6 py-3 rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-bg-1)] text-[var(--color-text-primary)] font-medium hover:bg-[var(--color-bg-2)] transition-colors text-sm"
    >
      Read the spellbook
    </a>
  </div>
  <figure data-role="product-screenshots">
    <div class="flex items-center justify-center gap-3 sm:gap-5">
      <a href="/site/images/apps/conversations.jpg" class="min-w-0 flex-1">
        <img
          src="/site/images/apps/conversations.jpg"
          alt="Conversations showing a cart task, tool calls, an expanded code diff, and tests in progress"
          width="973"
          height="791"
          loading="lazy"
          class="w-full rounded-xl border border-[var(--color-border)] shadow-lg"
        />
      </a>
      <a
        href="/site/images/apps/workbench-mobile.jpg"
        class="block w-[24%] shrink-0 overflow-hidden rounded-[1.5rem] border-[5px] border-zinc-800 bg-zinc-800 shadow-lg sm:rounded-[2rem] sm:border-[7px]"
      >
        <img
          src="/site/images/apps/workbench-mobile.jpg"
          alt="Workbench on a phone, with a cart work item assigned to Builder"
          width="390"
          height="844"
          loading="lazy"
          class="w-full"
        />
      </a>
    </div>
    <figcaption class="mt-4 text-xs text-[var(--color-text-muted)]">
      What talking to a sprite actually looks like: Conversations on a laptop, Workbench on a phone.
    </figcaption>
  </figure>
</section>

<%!-- The field guide. Every joke on the page, pinned to the word the manual
      uses for it, so the vocabulary arrives before the YAML does. --%>
<section class="max-w-5xl mx-auto px-6 pb-16" data-role="field-guide">
  <div class="border-t border-[var(--color-border)] pt-16">
    <.eyebrow label="Field guide" />
    <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-[var(--color-text-primary)] text-center">
      Know your herd.
    </h2>
    <p class="mt-3 text-center text-[var(--color-text-secondary)] max-w-xl mx-auto text-lg">
      Six creatures you will meet on this page, and what the manual calls them.
    </p>
    <dl class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <div
        :for={entry <- field_guide()}
        class="field-card rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-1)] p-5"
      >
        <dt class="flex items-center gap-3">
          <span class="field-glyph inline-block text-2xl leading-none" aria-hidden="true">
            {entry.glyph}
          </span>
          <span class="font-semibold text-[var(--color-text-primary)]">{entry.name}</span>
          <span class="ml-auto font-mono text-[11px] text-[var(--color-accent-ink)]">
            aka {entry.aka}
          </span>
        </dt>
        <dd class="mt-3 text-sm text-[var(--color-text-secondary)] leading-relaxed">
          {entry.body}
        </dd>
      </div>
    </dl>
  </div>
</section>

<%!-- The apps lead the page. The catalog owns their names, destinations and
      descriptions; the machine and API explanations follow the choices. --%>
<section class="max-w-5xl mx-auto px-6 pb-16">
  <div class="border-t border-[var(--color-border)] pt-16">
    <.eyebrow label="Apps" />
    <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-[var(--color-text-primary)] text-center">
      Things the herd built. Steal them.
    </h2>
    <p class="mt-3 text-center text-[var(--color-text-secondary)] max-w-2xl mx-auto text-lg">
      {built_app_count()} open-source apps run on the same API you would use. Poke at one, fork its source, or point it at your own goat.
    </p>
    <div class="mt-10 grid md:grid-cols-3 gap-6">
      <article
        :for={app <- flagship_apps()}
        class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-1)] p-5 flex flex-col"
        data-role="flagship"
      >
        <%!-- The glyph is an emoji out of built_apps/0, shared with
              /built-with. Set loose at `text-3xl` it read as a stray character
              above the title; in a bordered tile it reads as the app's mark,
              which is the job it is doing. --%>
        <div
          class="size-11 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-2)] flex items-center justify-center text-xl leading-none"
          aria-hidden="true"
          data-role="glyph"
        >
          {app.glyph}
        </div>
        <h3 class="mt-4 text-lg font-semibold text-[var(--color-text-primary)]">{app.name}</h3>
        <a href={app.screenshot.src} class="mt-4 block" aria-label={"View #{app.name} screenshot"}>
          <img
            src={app.screenshot.src}
            alt={app.screenshot.alt}
            width="973"
            height="791"
            loading="lazy"
            decoding="async"
            class="w-full rounded-lg border border-[var(--color-border)]"
          />
        </a>
        <p class="mt-2 text-sm text-[var(--color-text-secondary)] leading-relaxed flex-1">
          {app.flagship.homepage}
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-4">
          <a
            href={app.url}
            rel="noopener"
            class="inline-flex items-center px-4 py-2 rounded-lg bg-[var(--color-brand)] text-white font-medium hover:bg-[var(--color-brand-hover)] transition-colors text-sm"
          >
            Open app
          </a>
          <a
            href={app.source}
            rel="noopener"
            class="text-sm text-[var(--color-text-secondary)] underline underline-offset-2 hover:text-[var(--color-text-primary)]"
          >
            Source
          </a>
        </div>
      </article>
    </div>
    <p class="mt-8 text-center">
      <a
        href="/built-with"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-bg-1)] text-[var(--color-text-primary)] text-sm font-medium hover:bg-[var(--color-bg-2)] transition-colors"
      >
        Browse all {built_app_count()} apps
      </a>
    </p>
  </div>
</section>

<section class="max-w-5xl mx-auto px-6 pb-16 text-center" data-role="machine-story">
  <h2 class="text-2xl sm:text-3xl font-semibold text-[var(--color-text-primary)]">
    Every agent gets its own sprite.
  </h2>
  <p class="mt-4 text-lg text-[var(--color-text-secondary)] max-w-2xl mx-auto">
    Your repositories, packages and credentials show up with it.
    It naps between prompts and wakes with its work intact.
    <a href="/self-hosted" class="underline underline-offset-2">Raise your own herd</a>
    to try it.
  </p>
</section>

<%!-- Proof comes before the implementation detail. A reader sees one measured
      production use before the page asks them to parse the primitives and five
      code blocks.

      The agent never holds a cluster credential. It cannot merge for a
      different reason: GitHub refuses a self-approval from the account that
      clones, pushes a branch and opens the request. Keep those mechanisms
      separate in the copy. --%>
<section class="max-w-5xl mx-auto px-6 pt-8 pb-16">
  <div
    class="rounded-2xl border border-[var(--color-accent-line)] bg-[var(--color-accent-soft)] p-8 sm:p-12"
    data-role="case-study-callout"
  >
    <.eyebrow label="True story" align={:left} />
    <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-[var(--color-text-primary)]">
      The pager rings. A sprite gets out of bed too.
    </h2>
    <p class="mt-4 text-[var(--color-text-secondary)] max-w-2xl leading-relaxed">
      When a workload breaks, this Kubernetes cluster pages an on-call engineer and starts an agent at the same time. The agent investigates the alert and, when it finds a repository fix, opens one focused pull request. It never holds cluster credentials. A person decides whether to merge.
    </p>
    <div class="mt-10 grid gap-8 sm:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] sm:items-center sm:gap-10">
      <% lead_stat = case_lead_stat() %>
      <dl data-role="case-stat" data-emphasis="lead">
        <dt
          class="text-5xl sm:text-6xl font-semibold tracking-tight text-[var(--color-text-primary)]"
          data-role="figure"
        >
          {lead_stat.value}
        </dt>
        <dd class="mt-2 text-sm font-medium leading-snug text-[var(--color-text-primary)]">
          {lead_stat.home_label}
        </dd>
        <dd class="mt-2 text-xs leading-relaxed text-[var(--color-accent-ink)]">
          {lead_stat.note}
        </dd>
      </dl>
      <dl class="border-t border-[var(--color-accent-line)] sm:border-l sm:border-t-0 sm:pl-8">
        <div
          :for={stat <- case_supporting_stats()}
          class="grid grid-cols-[3.5rem_1fr] gap-4 border-b border-[var(--color-accent-line)] py-4 last:border-b-0 first:pt-0 sm:first:pt-4"
          data-role="case-stat"
          data-emphasis="supporting"
        >
          <dt
            class="text-2xl font-semibold tracking-tight text-[var(--color-text-primary)]"
            data-role="figure"
          >
            {stat.value}
          </dt>
          <dd class="self-center text-xs leading-snug text-[var(--color-accent-ink)]">
            {stat.home_label}
          </dd>
        </div>
      </dl>
    </div>
    <p class="mt-8 max-w-2xl text-xs text-[var(--color-text-secondary)]">
      Measured from {case_window()} on one Kubernetes cluster running live production workloads. Numbers reported by the cluster administrator (us).
    </p>
    <div class="mt-8">
      <a
        href="/case-studies/self-healing-infrastructure"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg border border-[var(--color-accent-line)] bg-[var(--color-bg-1)] text-[var(--color-text-primary)] text-sm font-medium hover:bg-[var(--color-bg-2)] transition-colors"
      >
        Read the incident timeline
      </a>
    </div>
  </div>
</section>

<%!-- The spell, directly after the proof: the shape comes before the
      argument, and the SDK call sits near the top of the page rather than
      under the feature inventory.

      It is on ink because the code is the substance of the section and there
      are five blocks of it; on a light ground they were five black rectangles
      floating on a white page. On ink they are the ground, lifted one step to
      `ink-1`. --%>
<section class="bg-[var(--color-ink-0)] text-[var(--color-ink-text)]">
  <div class="max-w-5xl mx-auto px-6 py-16">
    <.eyebrow label="The spell" tone={:ink} />
    <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-[var(--color-ink-text)] text-center">
      Write the spell once. After that, just talk.
    </h2>
    <%!-- The three resources are one file, so they are one code block. On wide
          screens its annotations occupy proportional rows beside it: 34/23/43
          follows the documents' rendered line counts (including each `---`),
          keeping every annotation level with the document it names. On narrow
          screens the numbered annotations become a compact preface to the
          manifest, where a side-by-side alignment would leave neither column
          enough room.

          The code column is the wider of the two, because a wrapped line of
          YAML is a defect and a wrapped line of prose is not. --%>
    <div class="mt-12">
      <div class="grid md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] gap-x-10 gap-y-5 items-stretch">
        <div class="grid md:grid-rows-[34%_23%_43%]">
          <div
            :for={step <- Enum.take(build_steps(), 3)}
            class="flex items-start gap-4 py-4 first:pt-0 last:pb-0 md:py-0 md:pr-4"
            data-role="setup-manifest-annotation"
          >
            <%!-- Outlined rather than filled. A filled blue disc is the shape
                  of every button on the page, and these are not clickable. --%>
            <span class="mt-0.5 flex-shrink-0 size-7 rounded-full border border-[var(--color-accent)] text-[var(--color-accent)] text-xs font-semibold flex items-center justify-center">
              {step.n}
            </span>
            <span class="text-[var(--color-ink-secondary)] leading-relaxed">
              <span class="font-medium text-[var(--color-ink-text)]">{step.title}</span>
              {step.body}
            </span>
          </div>
        </div>
        <pre
          class="min-w-0 rounded-xl border border-[var(--color-ink-border)] bg-[var(--color-ink-1)] text-[var(--color-code-text)] p-5 text-sm leading-relaxed overflow-x-auto"
          data-role="setup-manifest"
          phx-no-format
        ><code>{apply_example()}</code></pre>
      </div>

      <%!-- Applying the file and calling the agent happen after the manifest,
            so they keep their own rows and code blocks. The connector carries
            no number because applying is not another resource definition. --%>
      <div class="mt-8 border-t border-[var(--color-ink-border)] divide-y divide-[var(--color-ink-border)]">
        <div
          :for={step <- Enum.drop(build_steps(), 3)}
          class="grid md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] gap-x-10 gap-y-5 items-start py-8 last:pb-0"
        >
          <div class="flex items-start gap-4">
            <span
              :if={step.n}
              class="mt-0.5 flex-shrink-0 size-7 rounded-full border border-[var(--color-accent)] text-[var(--color-accent)] text-xs font-semibold flex items-center justify-center"
            >
              {step.n}
            </span>
            <span
              :if={!step.n}
              class="mt-0.5 flex-shrink-0 size-7 flex items-center justify-center"
              aria-hidden="true"
            >
              <span class="h-4 w-px bg-[var(--color-ink-border)]"></span>
            </span>
            <span class="text-[var(--color-ink-secondary)] leading-relaxed">
              <span class="font-medium text-[var(--color-ink-text)]">{step.title}</span>
              {step.body}
            </span>
          </div>
          <pre
            class="min-w-0 rounded-xl border border-[var(--color-ink-border)] bg-[var(--color-ink-1)] text-[var(--color-code-text)] p-5 text-sm leading-relaxed overflow-x-auto"
            phx-no-format
          ><code>{step.code}</code></pre>
        </div>
      </div>
    </div>
  </div>
</section>

<%!-- The goat's chores: six things the platform does so the agent does not
      have to. Each dt is an imperative and each dd names the mechanism; keep
      both rules when adding one. This is also the page's only mention of a
      Vault, so it states the HashiCorp collision before the feature
      (standards/voice-and-style.md). Left-aligned, because six items of dense
      reference read down a left margin. --%>
<section class="max-w-5xl mx-auto px-6 py-16">
  <.eyebrow label="Goat chores" align={:left} />
  <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-[var(--color-text-primary)] max-w-3xl">
    The agent gets the glory. The goat does the chores.
  </h2>
  <p class="mt-3 text-[var(--color-text-secondary)] max-w-2xl text-lg">
    Six boring things that happen so the fun part can.
  </p>
  <%!-- A definition list, which is what the page uses for a claim and the
        mechanism behind it (the protocols, the limits and the case study all
        do). These six were the only bordered cards on the homepage. Six boxes
        under three code blocks read as a pick-one feature grid, and these are
        not separable features: they are one run in order, from the machine to
        the trail it leaves.

        Each one now hangs off a rule instead. It gives the six a shared left
        edge and a countable shape without drawing six boxes. --%>
  <dl class="mt-12 grid sm:grid-cols-2 gap-x-12 gap-y-9">
    <div class="border-l-2 border-[var(--color-border-strong)] pl-5">
      <dt class="font-medium text-[var(--color-text-primary)]">
        Launch every run from the same reviewable setup.
      </dt>
      <dd class="mt-1.5 text-sm text-[var(--color-text-secondary)] leading-relaxed">
        An Environment defines repositories, packages, environment variables, setup scripts, and network policy. Keep it in git, review changes, and reuse it across runs.
      </dd>
    </div>
    <div class="border-l-2 border-[var(--color-border-strong)] pl-5">
      <dt class="font-medium text-[var(--color-text-primary)]">
        Change a credential without a redeploy.
      </dt>
      <dd class="mt-1.5 text-sm text-[var(--color-text-secondary)] leading-relaxed">
        Here, a Vault is a per-run override, not a central secret store. Its values override the Environment, so the same setup can run as you, a bot, or your customer. {Site.Brand.name()} scrubs secret values from stored output.
      </dd>
    </div>
    <div class="border-l-2 border-[var(--color-border-strong)] pl-5">
      <dt class="font-medium text-[var(--color-text-primary)]">
        Let the agent open the pull request.
      </dt>
      <dd class="mt-1.5 text-sm text-[var(--color-text-secondary)] leading-relaxed">
        The sandbox already has the checkout and the credential you assigned. The agent can commit, push, and open the pull request without a patch handoff.
      </dd>
    </div>
    <div class="border-l-2 border-[var(--color-border-strong)] pl-5">
      <dt class="font-medium text-[var(--color-text-primary)]">
        Build one interface for every runtime.
      </dt>
      <dd class="mt-1.5 text-sm text-[var(--color-text-secondary)] leading-relaxed">
        {Site.Brand.name()} normalizes text, reasoning, tool calls, results, and approval requests into one block schema. Request it with <code
          class="text-[var(--color-code-text)] bg-[var(--color-code-bg)] rounded px-1 py-0.5 text-xs"
          phx-no-format
        >?blocks=true</code>.
      </dd>
    </div>
    <div class="border-l-2 border-[var(--color-border-strong)] pl-5">
      <dt class="font-medium text-[var(--color-text-primary)]">
        Keep the workspace. Release the capacity.
      </dt>
      <dd class="mt-1.5 text-sm text-[var(--color-text-secondary)] leading-relaxed">
        While a sandbox waits, its checkout and work in progress stay intact, but it uses none of your concurrency. The next message wakes it on the same files.
      </dd>
    </div>
    <div class="border-l-2 border-[var(--color-border-strong)] pl-5">
      <dt class="font-medium text-[var(--color-text-primary)]">
        Trace what changed and who changed it.
      </dt>
      <dd class="mt-1.5 text-sm text-[var(--color-text-secondary)] leading-relaxed">
        The audit trail records who changed each resource and which fields changed, without storing their values. Each conversation also records the exact Agent version it ran under.
      </dd>
    </div>
  </dl>
</section>

<%!-- The band. Two sections about how a run behaves over time, on one tint
      with a rule between them rather than two tinted bands with a page
      between, because they answer the same question. --%>
<div class="bg-[var(--color-band)] border-y border-[var(--color-border)]">
  <%!-- The durable thread, told as the thing a builder maps onto their own ids
        rather than as a coworker they message. The key is `channel_id`
        (`Conversations.start_or_resume_conversation/2`); it resumes a
        conversation for the same Agent, Environment and Vault rather than
        acting as a global unique key.

        The memory boundary names the default ephemeral mode. A persistent
        sandbox survives the end of one conversation, which is the second
        choice in Scale directly below. --%>
  <section class="max-w-5xl mx-auto px-6 py-16">
    <.eyebrow label="Memory" />
    <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-[var(--color-text-primary)] text-center">
      Sprites nap. They do not forget.
    </h2>
    <div class="mt-10 max-w-2xl mx-auto space-y-5 text-[var(--color-text-secondary)] leading-relaxed">
      <p>
        Bind a conversation to a customer, ticket or Slack channel id. Send that id with the same Agent, Environment and Vault to resume the live conversation. You do not store or look up a {Site.Brand.name()} conversation id.
      </p>
      <p>
        Between prompts, the sprite naps with its files intact. The next message or a scheduled run wakes it.
      </p>
      <p>
        In the default mode, the disk belongs to that conversation. End the conversation and its workspace goes with it.
      </p>
    </div>
    <p class="mt-10 text-center">
      <a
        href="/docs/api"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-bg-1)] text-[var(--color-text-primary)] text-sm font-medium hover:bg-[var(--color-bg-2)] transition-colors"
      >
        See the conversation API
      </a>
    </p>
  </section>

  <%!-- Scale. Two cards name the two axes: a sandbox per job, or many
        conversations on one persistent sandbox. The published-ceiling card and
        provenance card that used to sit here moved to the limits and the
        "what you stop building" sections, which already owned those subjects;
        the closing "two honest limits" paragraph restated both and is gone.
        Do not put a number on the fleet ceiling here, or in the limits section:
        it is an operator setting rather than a published product promise. --%>
  <section class="max-w-5xl mx-auto px-6 pb-16">
    <div class="border-t border-[var(--color-border)] pt-16">
      <.eyebrow label="Scale" />
      <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-[var(--color-text-primary)] text-center">
        A hundred tickets? Summon a hundred sprites.
      </h2>
      <p class="mt-3 text-center text-[var(--color-text-secondary)] max-w-xl mx-auto text-lg">
        No queue to run, no worker pool to size, no image to bake per repository.
      </p>

      <div class="mt-10 grid sm:grid-cols-2 gap-6">
        <%!-- Default ephemeral mode: one isolated sandbox per job. --%>
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-1)] p-6">
          <h3 class="font-semibold text-[var(--color-text-primary)] mb-2">
            One sprite per job
          </h3>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
            In the default mode, one call starts one conversation on its own sandbox. A batch is a loop. Every sandbox carries the bundled skill, so an agent can start more work and collect the replies.
          </p>
        </div>

        <%!-- ADR 0023: many conversations, one sandbox, with the real capacities --%>
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-1)] p-6">
          <h3 class="font-semibold text-[var(--color-text-primary)] mb-2">
            Or one sprite, many conversations
          </h3>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
            Use persistent mode when many conversations need the same checkout. They keep separate transcripts and run up to the runtime's capacity. Work beyond that limit is refused, not queued.
          </p>
        </div>
      </div>
    </div>
  </section>
</div>

<%!-- FORK ONE: drive it with the stack you have, or start from something that
      already works. Two sections on one surface with a rule between them,
      which is the shape State and Scale use above for the same reason.

      On the page ground rather than a tint, because the band above is tinted
      and two tinted regions with nothing between them read as one long tint.
      The rule does the pairing instead.

      Apps used to be banded with Self-host, on the argument that both are the
      reader looking at somebody else's copy of the product. True, and the
      wrong cut. An app you start from is the alternative to writing against
      the protocols; running it yourself is the alternative to paying us. Each
      fork now sits beside the thing it forks. --%>
<%!-- Put Fountain behind the stack the reader already uses. Three ways in,
      all generally available, so no row carries a badge. AG-UI and OpenAI chat
      completions were rows here until Fountain retired both (fountain ADR
      0057); the lead no longer promises that a gateway or framework keeps
      speaking its own protocol, because nothing native gives that back. --%>
<section class="max-w-5xl mx-auto px-6 py-16">
  <.eyebrow label="Protocols" />
  <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-[var(--color-text-primary)] text-center">
    The goat speaks your protocols.
  </h2>
  <p class="mt-3 text-center text-[var(--color-text-secondary)] max-w-xl mx-auto text-lg">
    Your editor or chat surface keeps speaking ACP, and your agents keep speaking MCP. Everything else drives the roster through the API our own apps use.
  </p>

  <dl class="mt-12 max-w-3xl mx-auto divide-y divide-[var(--color-border)]">
    <div class="sm:flex sm:gap-8 py-5 first:pt-0 last:pb-0">
      <dt class="font-medium text-[var(--color-text-primary)] sm:w-56 sm:shrink-0">
        Agent Client Protocol
      </dt>
      <dd class="mt-1 sm:mt-0 text-sm text-[var(--color-text-secondary)] leading-relaxed">
        Connect an ACP editor or chat surface to any agent on your roster with
        <%!-- One line on purpose: brand_chrome_test.exs pins `>fountain acp</code>`,
              and HEEx renders a wrapped element with the whitespace it was
              written with. --%>
        <code
          class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-bg-2)] text-[var(--color-text-primary)]"
          phx-no-format
        >fountain acp</code>.
      </dd>
    </div>

    <div class="sm:flex sm:gap-8 py-5 first:pt-0 last:pb-0">
      <dt class="font-medium text-[var(--color-text-primary)] sm:w-56 sm:shrink-0">
        MCP, both directions
      </dt>
      <dd class="mt-1 sm:mt-0 text-sm text-[var(--color-text-secondary)] leading-relaxed">
        Let agents use the servers you declare, then expose the roster so they can delegate to each other.
      </dd>
    </div>

    <div class="sm:flex sm:gap-8 py-5 first:pt-0 last:pb-0">
      <dt class="font-medium text-[var(--color-text-primary)] sm:w-56 sm:shrink-0">
        REST, SSE and webhooks
      </dt>
      <dd class="mt-1 sm:mt-0 text-sm text-[var(--color-text-secondary)] leading-relaxed">
        Start a conversation, stream its blocks and receive a signed webhook when the turn ends, from your own code, an SDK or the CLI.
      </dd>
    </div>
  </dl>

  <p class="mt-10 text-center text-sm">
    <a href="/integrations" class="text-[var(--color-brand)] hover:underline font-medium">
      See what connects today
    </a>
  </p>
</section>

<%!-- Lane three's section on the homepage. The runner concession sits beside
      the runner claim rather than a page away, because the hero promises a
      boundary and the default runner backend has none.

      The section used to promise "the whole thing" while naming two paths:
      self-host the control plane, or keep the hosted control plane and attach
      runners. It also made "own hardware" the boundary, which excluded an
      operator running Fountain in a cloud account. Ownership is the common
      decision, so the heading and deck name how much of the stack the reader
      wants to own and where each part runs.

      The two paragraphs scan as parallel choices and replace "nothing is held
      back" with things a reader can verify: open source, the compose bring-up,
      the Kubernetes manifests and the shared release image.

      The runner note keeps its own rule and its own beat because the default
      process backend is a concession, not the offer. It also names the
      Firecracker override now that trusted mode is no longer the runner's only
      backend. The limit and the safer boundary sit in the same place.

      It opens the ink finale now that the pricing above it is gone, so it
      takes the band edge as its top and carries no rule of its own. --%>
<section class="bg-[var(--color-ink-0)]">
  <div class="max-w-5xl mx-auto px-6 pb-16">
    <div class="pt-16">
      <.eyebrow label="Self-host" tone={:ink} />
      <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-[var(--color-ink-text)] text-center">
        Raise your own herd.
      </h2>
      <p class="mt-3 text-center text-[var(--color-ink-secondary)] max-w-xl mx-auto text-lg">
        The same API, SDK and CLI. Run Fountain and Postgres in your own account, and connect machines from your network.
      </p>

      <div class="mt-10 max-w-2xl mx-auto space-y-4 text-[var(--color-ink-secondary)] leading-relaxed">
        <p>
          <strong class="font-medium text-[var(--color-ink-text)]">
            Run the control plane yourself.
          </strong>
          {Site.Brand.engine()} is open source. Docker Compose brings up Fountain and Postgres, while plain Kubernetes manifests run the same release image.
        </p>
        <p>
          <strong class="font-medium text-[var(--color-ink-text)]">
            Bring your own sandbox compute.
          </strong>
          A runner dials out from your network and opens no inbound port.
        </p>
        <p class="border-l-2 border-[var(--color-ink-border)] pl-4 text-sm text-[var(--color-ink-secondary)]">
          By default, a runner uses trusted mode. The agent runs as you, with your network and tools and no container between. Use it where you would hand a colleague a shell, or use the Firecracker backend on Linux with KVM for a microVM boundary.
        </p>
      </div>

      <p class="mt-10 text-center">
        <a
          href="/self-hosted"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg border border-[var(--color-ink-border)] bg-[var(--color-ink-1)] text-[var(--color-ink-text)] text-sm font-medium hover:bg-[var(--color-ink-2)] transition-colors"
        >
          See what self-hosting takes
        </a>
      </p>
    </div>
  </div>
</section>

<%!-- Questions. The limits and the security answers live on /faq; this is
      the signpost to them, because a page that mentions no limit anywhere is
      the shape the voice standard argues against. Left-aligned: it is the one
      section of the ink finale that is reference rather than story. --%>
<section class="bg-[var(--color-ink-0)]">
  <div class="max-w-5xl mx-auto px-6 pb-16">
    <div class="border-t border-[var(--color-ink-border)] pt-16">
      <.eyebrow label="Questions" align={:left} tone={:ink} />
      <h2 class="mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-[var(--color-ink-text)]">
        Ask the goat anything.
      </h2>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-[var(--color-ink-secondary)] max-w-lg">
          Read every limit and review the security model yourself. The answers tell you what the software enforces and where it stops.
        </p>
        <a
          href="/faq"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg border border-[var(--color-ink-border)] bg-[var(--color-ink-1)] text-[var(--color-ink-text)] text-sm font-medium hover:bg-[var(--color-ink-2)] transition-colors sm:shrink-0"
        >
          Read the answers
        </a>
      </div>
    </div>
  </div>
</section>

<%!-- Footer CTA. There is nothing to sign up for, so the ask is a
      conversation: the person who runs it, then the manual. On ink the primary
      button is `--color-ink-brand`, which is the brand blue the dark theme
      already uses. `--color-brand` is #0b5acc and would be a dark button on a
      near-black ground. --%>
<section class="bg-[var(--color-ink-0)] border-t border-[var(--color-ink-border)]">
  <div class="max-w-5xl mx-auto px-6 py-20 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--color-ink-text)] mb-4">
      Want to talk goats?
    </h2>
    <p class="text-[var(--color-ink-secondary)] mb-9 max-w-lg mx-auto text-lg leading-relaxed">
      {Site.Brand.name()} is not open for sign-ups. It is a side project with horns. If you are curious about it, or about raising a herd of your own, {Site.Brand.contact_name()} would love to hear from you.
    </p>
    <a
      href={Site.Brand.contact_url()}
      class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-lg bg-[var(--color-ink-brand)] text-[var(--color-ink-0)] font-semibold hover:opacity-90 transition-opacity"
    >
      <span aria-hidden="true">🐐</span> Say baa to {Site.Brand.contact_name()}
    </a>
    <p class="mt-5 text-sm text-[var(--color-ink-secondary)]">
      Or <a
        href="/docs"
        class="underline underline-offset-2 hover:text-[var(--color-ink-text)]"
      >read the manual</a>.
    </p>
  </div>
</section>

<%!-- Pet the goat. It hops, it baas, it throws a few sparks, and if you keep
      at it, it suggests you would be better off emailing Jake. A reader who
      asked for reduced motion still gets the baa, without the hop. --%>
<script>
  (function () {
    var goat = document.querySelector('[data-role="goat"]');
    if (!goat) return;
    var still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var lines = ["Baa!", "Baa!", "Baaa!", "BAAA!", "baa?", "Baa! ✨", "okay okay", "baa (email Jake)"];
    var pets = 0;
    var spark = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c.6 6.4 5.6 11.4 12 12-6.4.6-11.4 5.6-12 12-.6-6.4-5.6-11.4-12-12C6.4 11.4 11.4 6.4 12 0z"/></svg>';
    goat.addEventListener("click", function () {
      var said = document.createElement("span");
      said.className = "goat-baa";
      said.textContent = lines[Math.min(pets, lines.length - 1)];
      pets += 1;
      goat.appendChild(said);
      setTimeout(function () { said.remove(); }, 950);
      if (still) return;
      goat.classList.remove("is-hopping");
      void goat.offsetWidth;
      goat.classList.add("is-hopping");
      for (var i = 0; i < 7; i++) {
        var s = document.createElement("span");
        var angle = (Math.PI * 2 * i) / 7 + Math.random() * 0.5;
        var dist = 46 + Math.random() * 26;
        s.className = "goat-spark";
        s.innerHTML = spark;
        s.style.setProperty("--dx", Math.cos(angle) * dist + "px");
        s.style.setProperty("--dy", Math.sin(angle) * dist + "px");
        goat.appendChild(s);
        setTimeout(function (el) { el.remove(); }, 850, s);
      }
    });
  })();
</script>
